#define SPEED_TIME 60 // speed of the transition

#define BRIGHT_DAY   4  // 0..15
#define BRIGHT_NIGHT 0  // 0..15
#define NIGHT_START 22  // hour when dimming starts
#define NIGHT_END    6  // hour when dimming ends

#define MAX_MESG  40


